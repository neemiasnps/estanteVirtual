    <!-- MODAL AVALIAÇÃO -->
    <div id="modal-avaliacao" class="modal">

        <div class="modal-content">

            <h5>Avaliar livro</h5>

            <div id="etapa-validacao">

                <div class="input-field">

                    <input type="text"
                           id="identificacao">

                    <label for="identificacao">
                        CPF ou e-mail
                    </label>

                </div>

                <button class="btn amber darken-2"
                        id="btn-validar-avaliacao">

                    Continuar

                </button>

            </div>

            <div id="etapa-formulario"
                 style="display:none;">

                <div class="avaliacao-estrelas-area">

                    <p class="titulo-avaliacao">
                        Sua avaliação
                    </p>

                    <div class="estrelas-input" id="estrelas-input">

                        <i class="material-icons estrela-avaliacao"
                           data-value="1">
                            star_border
                        </i>

                        <i class="material-icons estrela-avaliacao"
                           data-value="2">
                            star_border
                        </i>

                        <i class="material-icons estrela-avaliacao"
                           data-value="3">
                            star_border
                        </i>

                        <i class="material-icons estrela-avaliacao"
                           data-value="4">
                            star_border
                        </i>

                        <i class="material-icons estrela-avaliacao"
                           data-value="5">
                            star_border
                        </i>

                    </div>

                </div>

                <div class="input-field">

                    <textarea id="comentario"
                              class="materialize-textarea"></textarea>

                    <label for="comentario">
                        Comentário
                    </label>

                </div>

                <button class="btn green"
                        id="btn-enviar-avaliacao">

                    Enviar avaliação

                </button>

            </div>

        </div>

    </div>

    <!-- Modal de Login -->
    <div id="modal-login" class="modal">
        <div class="modal-content">
            <h4>Login</h4>
            <div class="row">
                <form class="col s12" id="form-login">
                    <div class="row">
                        <div class="input-field col s12">
                            <i class="material-icons prefix">email</i>
                            <input id="email" type="text" class="validate" required>
                            <label for="email">E-mail</label>
                        </div>
                        <div class="input-field col s12">
                            <i class="material-icons prefix">lock</i>
                            <input id="password" type="password" class="validate" required>
                            <label for="password">Senha</label>
                        </div>
                    </div>
                    <button class="btn waves-effect waves-light" type="submit" name="action">Login
                        <i class="material-icons right">login</i>
                    </button>
                </form>
            </div>
        </div>
    </div>

